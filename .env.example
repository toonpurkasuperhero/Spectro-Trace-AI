# Cloudinary Credentials
# Find your Cloud Name at: https://console.cloudinary.com → top-left of the dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=

# Application & Environment
ENV=dev
DEMO_MODE=false
API_BASE=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
DATABASE_URL=sqlite:///./spectrotrace.db

# Budget & Safety Caps (calls per day)
MAX_GENERATIVE_CALLS_PER_DAY=50
MAX_GENFILL_CALLS_PER_DAY=20
MAX_GENREMOVE_CALLS_PER_DAY=20
MAX_IMAGEGEN_CALLS_PER_DAY=10
MAX_VISION_CALLS_PER_DAY=100

# Vision Provider Configuration
VISION_PROVIDER=fallback
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash

# Cloudinary Image Generation Add-on (required for Simulation Lab - Feature B)
# Set to the Cloudinary API base URL once the Image Generation add-on is enabled
# IMAGE_GEN_BASE=https://api.cloudinary.com/v2
IMAGE_GEN_BASE=

# Simulation defaults
SIM_DEFAULT_TIER=standard
SIM_ALLOW_PREMIUM=false

# Upload Presets (configured in Cloudinary console)
CLD_PRESET_PRINT=st_print
CLD_PRESET_THERMAL=st_thermal
CLD_PRESET_SPECIMEN=st_specimen
CLD_PRESET_AUDIO=st_audio
